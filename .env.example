# Sitio agrohubs.cl — variables opcionales (copiar a .env.local para desarrollo; en Vercel: Settings > Environment Variables)

# Formulario de evaluación/contacto/pedidos: endpoint del API de la plataforma AgroHubs.
# Por defecto: https://api.agrohubs.cl/api/v1/site/leads
VITE_LEADS_URL=

# Base del API para reenviar los links de seguimiento de correos antiguos (/api/t).
# Por defecto: https://api.agrohubs.cl
AGROHUBS_API_URL=
