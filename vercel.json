{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "redirects": [
    {
      "source": "/admin",
      "has": [{ "type": "query", "key": "id", "value": "(?<id>.+)" }],
      "destination": "https://admin.agrohubs.cl/site/propuestas?id=:id",
      "permanent": false
    },
    {
      "source": "/admin",
      "has": [{ "type": "query", "key": "tab", "value": "correo" }],
      "destination": "https://admin.agrohubs.cl/site/correo",
      "permanent": false
    },
    {
      "source": "/admin",
      "has": [{ "type": "query", "key": "tab", "value": "seguimiento" }],
      "destination": "https://admin.agrohubs.cl/site/seguimiento",
      "permanent": false
    },
    {
      "source": "/admin",
      "has": [{ "type": "query", "key": "tab", "value": "cuentas" }],
      "destination": "https://admin.agrohubs.cl/site/boveda",
      "permanent": false
    },
    {
      "source": "/admin",
      "destination": "https://admin.agrohubs.cl/",
      "permanent": false
    },
    {
      "source": "/admin/:path*",
      "destination": "https://admin.agrohubs.cl/",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/:path*"
    },
    {
      "source": "/((?!api/|assets/|apis/).*)",
      "destination": "/"
    }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    },
    {
      "source": "/apis/(.*).md",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/markdown; charset=utf-8"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex, follow"
        }
      ]
    },
    {
      "source": "/llms(.*).txt",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        }
      ]
    },
    {
      "source": "/apis(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, s-maxage=86400, stale-while-revalidate=604800"
        }
      ]
    }
  ],
  "cleanUrls": true
}
